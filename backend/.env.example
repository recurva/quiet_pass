# App
APP_NAME=QuietPass API
ENVIRONMENT=local
DEBUG=true
LOG_LEVEL=INFO

# Postgres (durable source of truth: users, groups, memberships)
POSTGRES_USER=quietpass
POSTGRES_PASSWORD=quietpass
POSTGRES_DB=quietpass
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
DATABASE_URL=postgresql+asyncpg://quietpass:quietpass@localhost:5433/quietpass

# Redis (live status + pub/sub, not durable)
REDIS_URL=redis://localhost:6379/0

# CORS (add http://localhost:<flutter web port> for local Flutter web dev)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5000"]

# Firebase project id, for verifying phone-auth ID tokens (checked against
# the token's aud/iss claims). Not a secret. ID tokens are verified by hand
# against Google's public certs (app/core/firebase.py) rather than via the
# Admin SDK, since this project's org policy blocks service-account key
# creation.
FIREBASE_PROJECT_ID=quietpass-app

# Quiet-pulse spam limits (optional; these are the defaults)
# QUIET_PULSE_COOLDOWN_SECONDS=900
# QUIET_PULSE_DAILY_CAP=6

# FCM push send credentials. This is a DIFFERENT need from FIREBASE_PROJECT_ID
# above: verifying a sign-in token needs no credentials, but *sending* a push
# notification does — there's no credential-free path for that direction.
# Set at most ONE of the two options below. Never commit an actual key.
#
# Option A: a downloaded key. Never commit the key itself.
# FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# FIREBASE_SERVICE_ACCOUNT_JSON=
#
# Option B: impersonate a service account via Application Default
# Credentials — no key file needed at all. Local dev setup:
#   1. gcloud auth application-default login   (as yourself)
#   2. Make sure your own account has Service Account Token Creator on the
#      target service account (see README's Push section for the exact
#      gcloud command).
# FCM_IMPERSONATE_SERVICE_ACCOUNT=firebase-adminsdk-fbsvc@quietpass-app.iam.gserviceaccount.com
#
# In production, don't impersonate from a developer's login — run the
# backend *as* that service account directly instead (Cloud Run/GCE/GKE
# workload identity), and leave both settings above unset.
#
# If none of the above is configured, push sending just no-ops with a
# warning log (app/services/push_service.py) instead of failing nudge
# creation — nudges keep working over the WebSocket regardless.
